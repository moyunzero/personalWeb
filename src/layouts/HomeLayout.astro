---
import BaseLayout from './BaseLayout.astro';
import type { SeoInput } from '../lib/seo';
import { personJsonLd, websiteJsonLd } from '../lib/seo';
import HomeHeader from '../components/islands/HomeHeader';
import '../index.css';

interface Props {
    seo: SeoInput;
}

const { seo } = Astro.props;
const jsonLd = [websiteJsonLd(), personJsonLd()];
---

<BaseLayout seo={seo} jsonLd={jsonLd} htmlClass="home-cosmos-scroll">
    <HomeHeader client:visible />
    {/* Cosmos layers live outside the z-10 content stacking context so content paints above them. */}
    <slot name="background" />
    <div class="relative z-10" data-cosmos-hit>
        <slot />
    </div>
</BaseLayout>
