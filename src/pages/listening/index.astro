---
import BlogLayout from '../../layouts/BlogLayout.astro';
import ListeningFlashcards from '../../components/islands/ListeningFlashcards.tsx';
import { getListeningEntries } from '../../lib/listening';
import { SITE } from '../../lib/site';

const entries = await getListeningEntries();
const baseUrl = import.meta.env.BASE_URL;
---

<BlogLayout
    seo={{
        title: SITE.name,
        description: SITE.description,
        path: '/listening/',
    }}
    footerCredit="语音：Piper · en_US-amy-medium · CC BY-SA"
>
    <ListeningFlashcards client:load entries={entries} baseUrl={baseUrl} />
</BlogLayout>
