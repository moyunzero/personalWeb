---
import { getCollection } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import RelatedPosts from '../../components/blog/RelatedPosts.astro';
import EditorialHeader from '../../components/blog/EditorialHeader.astro';
import { getPublishedPosts } from '../../lib/blog';
import { getRelatedForEntry } from '../../lib/related';
import { renderMarkdown } from '../../lib/markdown';
import { SITE } from '../../lib/site';
import MermaidHydrator from '../../components/islands/MermaidHydrator';
import TimelineIsland from '../../components/islands/TimelineIsland';
import { getTimelineEvents } from '../../lib/timeline';

export async function getStaticPaths() {
    const posts = await getCollection('posts', ({ data }) => !data.draft);
    return posts.map((post) => ({
        params: { slug: post.data.slug },
        props: { post },
    }));
}

const { post } = Astro.props;
const { data, body } = post;
const html = body?.trim() ? await renderMarkdown(body) : '';
const allPosts = await getPublishedPosts();
const related = getRelatedForEntry(post, allPosts, 3);
const hasMermaid = html.includes('mermaid-diagram-host');
const isTimeline = data.slug === 'ai-timeline';
const timelineEvents = isTimeline ? await getTimelineEvents() : [];
---

<BlogLayout
    seo={{
        title: `${data.title} · ${SITE.name}`,
        description: data.description,
        path: `/blog/${data.slug}/`,
        canonical: data.canonical,
        ogImage: data.ogImage ?? data.coverImage,
        noindex: data.noindex,
        type: 'article',
        publishedAt: data.publishedAt,
        updatedAt: data.updatedAt,
        keywords: data.keywords,
    }}
>
    <article class:list={['mx-auto', isTimeline ? 'max-w-4xl' : 'max-w-3xl']}>
        <EditorialHeader
            title={data.title}
            description={isTimeline ? undefined : data.description}
            publishedAt={data.publishedAt}
            categories={data.categories}
            tags={isTimeline ? [] : data.tags}
            author={isTimeline ? undefined : data.author}
            readTime={isTimeline ? undefined : data.readTime}
            coverImage={isTimeline ? undefined : data.coverImage}
        />
        {html.trim() ? <div class="prose-blog" set:html={html} /> : null}
        {
            isTimeline ? (
                <TimelineIsland client:load events={timelineEvents} />
            ) : null
        }
    </article>
    {isTimeline ? null : <RelatedPosts heading={related.heading} posts={related.posts} />}
    {hasMermaid ? <MermaidHydrator client:idle /> : null}
</BlogLayout>
