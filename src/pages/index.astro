---
import HomeLayout from '../layouts/HomeLayout.astro';
import Main from '../components/home/Main.astro';
import About from '../components/home/About.astro';
import Skill from '../components/home/Skill.astro';
import Work from '../components/home/Work.astro';
import HomeFooter from '../components/home/HomeFooter.astro';
import ContactIsland from '../components/islands/ContactIsland';
import HomeMotion from '../components/islands/HomeMotion';
import CosmicStarfieldIsland from '../components/islands/CosmicStarfieldIsland';
import MouseTrailIsland from '../components/islands/MouseTrailIsland';
import GameIsland from '../components/islands/GameIsland';
import { SITE } from '../lib/site';

const posterUrl = `${import.meta.env.BASE_URL}threejs-assets/web/hdr_blue_nebulae_poster.webp`;
---

<HomeLayout
    seo={{
        title: `${SITE.name} · 个人站点`,
        description: SITE.description,
        path: '/',
    }}
>
    {/* SSR HDR poster; WebGL fades in after successful init (AC-1 / AC-5). */}
    <div
        slot="background"
        data-cosmos-fallback
        class="pointer-events-none fixed inset-0 z-0 overflow-hidden"
        style="background-color:#05060f"
        aria-hidden="true"
    >
        <img
            src={posterUrl}
            alt=""
            width="1920"
            height="960"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover opacity-90"
        />
        <div
            class="absolute inset-0"
            style="background:linear-gradient(to bottom, rgba(5,6,15,0.55) 0%, rgba(5,6,15,0.25) 22%, rgba(5,6,15,0.08) 45%, rgba(5,6,15,0.18) 100%)"
        >
        </div>
    </div>
    <main data-cosmos-hit>
        <Main />
        <About />
        <Skill />
        <Work />
        <ContactIsland client:visible />
    </main>
    <HomeFooter />
    <HomeMotion client:load />
    <CosmicStarfieldIsland client:visible="react" slot="background" />
    <MouseTrailIsland client:idle="react" />
    <GameIsland client:only="react" />
</HomeLayout>
