# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependencies & build output
node_modules
dist
dist-ssr
.astro/
.lighthouseci/
coverage/
.cache/
*.tsbuildinfo

# Generated site artifacts (rebuilt by Astro / scripts)
public/sitemap.xml
public/robots.txt
public/posts-index.json
public/rss.xml

# Yarn is the package manager; ignore npm lockfile if generated locally
package-lock.json

# Environment & secrets (keep only .env.example as the public template)
# Production injects secrets via GitHub Actions / host env, never the repo
*.local
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
credentials.json
**/credentials.json
service-account*.json
**/secrets/

# Playwright / MCP debug snapshots (local test artifacts)
.playwright-mcp/
test-results/
playwright-report/

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local AI / agent tooling (machine-specific; not part of the open source app)
.cursor/
.cursorrules
.agents/
.claude/
.kiro/
.codegraph/
.planning/
.tmp/

# Local Remotion / video experiment (large; not part of the Astro site)
video/

# Cosmos source textures (~100MB+ 8K/HDR/.blend). Runtime uses public/threejs-assets/web/ only.
# Regenerate derivatives locally with `yarn assets:cosmos` when sources change.
assets/threejs-source/

# Spectacle shark source (.blend + 4K). Runtime uses public/threejs-assets/web/spectacle/ only.
# Regenerate with `yarn assets:spectacle` when sources change.
assets/spectacle-source/

# Notion sync / UAT scratch image dirs (empty placeholders from automation runs)
public/images/blog/**/*uat*/

# Test files (allow project tests/ suite)
*.test.js
*.test.jsx
*.test.ts
*.test.tsx
*.spec.js
*.spec.jsx
*.spec.ts
*.spec.tsx
!tests/
!tests/**
src/test/
